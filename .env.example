# HireLens AI - Environment Configuration Template
# Copy this file to .env and customize as needed.

# Flask Application
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# LLM Configuration (OpenAI-compatible)
# Leave empty to run with high-precision deterministic local rule-based engine
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Application Settings
UPLOAD_MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,txt
BLIND_SCREENING_DEFAULT=false

# Persistence (SQLite path defaults to instance/hirelens.db locally or /tmp/hirelens.db in serverless)
DATABASE_PATH=
